<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- R26 · 长任务前台服务：四个权限跟着 targetSdk 35 一起声明，
         缺任一权限 startForeground 会抛 SecurityException。
         R158 · 系统级浮窗权限按需申请，用于可选的悬浮进度控件
         （见 core/KeepAlive.kt）。它不是保活白名单，默认不常显、
         停止时 removeView；设置页给开关与引导。
         R375 · 新增 INTERNET 用于用户手动开启的本机/局域网网关监听。
         R377 · 用户推翻「只本机」，要求必须跨公网、零付费、不买服务器：
         同一份 INTERNET 现在也用于**用户手动开启的跨网中继主动出站**
         （只允许 api.github.com，见 relay/RelayClient.kt）。
         口径迁移为「除 relay 包外源码零出站」；relay 包由 r377_verify.py 单独守：
         只连 api.github.com、Token 由用户填、正文即用即删、不硬编码凭据。
         文字会经过用户自己的私有 GitHub 仓库，「零上传」不再成立，已如实告知用户。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- R377 · 远程 API 被调用时给「开始 / 结束」两种不同节奏的震动反馈，
         normal 级、安装即授；只在跨网中继前台服务干活时触发。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- R386 · 应用更新 / 开机后按用户已保存的开关恢复两个前台服务；
         不是保活，只接官方豁免的三个系统广播，见 core/ResumeReceiver.kt。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- R175 · 纯端侧 App，私有书全文 / 数 GB 模型 / 成品音频 / 断点 /
         含正文片段的诊断日志都不该被系统备份或设备迁移带走。allowBackup=false
         是主闸门；dataExtractionRules 是 targetSdk 31+ 的纵深防御。 -->
    <application
        android:name=".TingbenApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/data_extraction_rules"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tingben">
        <activity android:name=".MainActivity" android:exported="true" android:label="@string/app_name"
            android:theme="@style/Theme.Tingben" android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 在其他 App（微信、文件管理器、浏览器）里点「打开方式 / 分享」能选到听本。
                 content:// 为主，file:// 兜底；R375 起清单含 INTERNET 但仅用于
                 用户手动开启的本机网关监听，App 本身仍零出站、零上传。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:scheme="content" />
            </intent-filter>
        </activity>

        <!-- R26 · 只从可见界面启动；不导出、不伪装 mediaPlayback。
             Android 15+ 的 dataSync / mediaProcessing 各有「24h 内累计 6h」上限，
             长任务靠每段落盘的检查点续跑，不承诺永不中断。
             R161：onTimeout(int,int) 收尾 6h 上限、ApplicationExitInfo 退出原因
             进诊断日志、可选悬浮进度（默认关）。
             不做 START_REDELIVER_INTENT：进程被杀后 Producer 协程已死，系统拿旧
             Intent 重启的只是一个空壳服务。恢复靠「每段落盘 + 开软件弹窗续跑」。 -->
        <service
            android:name=".ProduceService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <!-- R375 · 语音网关独立 specialUse 前台服务：不复用 mediaProcessing，
             否则长驻监听会吃掉 Android 15 每 24h 6h 的额度、把整本听书挤掉。
             不导出；网关默认关闭，只有用户在设置页点「开启网关」才起来。 -->
        <service
            android:name=".gateway.GatewayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户手动开启的本机/局域网语音合成网关，默认关闭" />
        </service>

        <!-- R377 · 跨网中继独立 specialUse 前台服务：轮询 GitHub 免费仓库的
             queue/，用本机预设合成并压缩后回传；默认关闭，不导出。 -->
        <service
            android:name=".relay.RelayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户手动开启的跨网语音中继，只连 api.github.com，默认关闭" />
        </service>

        <receiver android:name=".core.PlaybackActions" android:exported="false">
            <intent-filter>
                <action android:name="com.tingben.app.PLAY_TOGGLE" />
                <action android:name="com.tingben.app.PLAY_NEXT" />
                <action android:name="com.tingben.app.PLAY_PREV" />
                <action android:name="com.tingben.app.PLAY_STOP" />
            </intent-filter>
        </receiver>

        <!-- R386 · 不导出；只接三个官方豁免广播，进程死了按 Prefs 补拉服务，
             不注册 USER_PRESENT / SCREEN_ON 之类高频广播强拉活。 -->
        <receiver android:name=".core.ResumeReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- R26 · 长任务前台服务：四个权限跟着 targetSdk 35 一起声明，
         缺任一权限 startForeground 会抛 SecurityException。绝不申请 INTERNET。
         R158 · 旧约束「不申请 SYSTEM_ALERT_WINDOW」已由用户推翻：
         系统级浮窗权限按需申请，用于可选的悬浮进度控件（见 core/KeepAlive.kt）。
         它不是保活白名单，默认不常显、停止时 removeView；设置页给开关与引导。
         无障碍权限旧约束同样清掉，但当前无真实用途，暂不声明服务。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".TingbenApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:largeHeap="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tingben">
        <activity android:name=".MainActivity" android:exported="true" android:label="@string/app_name"
            android:theme="@style/Theme.Tingben" android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 在其他 App（微信、文件管理器、浏览器）里点「打开方式 / 分享」能选到听本。
                 content:// 为主，file:// 兜底；不加 INTERNET，仍纯离线。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:scheme="content" />
            </intent-filter>
        </activity>

        <!-- R26 · 只从可见界面启动；不导出、不伪装 mediaPlayback。
             Android 15+ 的 dataSync / mediaProcessing 各有「24h 内累计 6h」上限，
             长任务靠每段落盘的检查点续跑，不承诺永不中断。
             R161：onTimeout(int,int) 收尾 6h 上限、ApplicationExitInfo 退出原因
             进诊断日志、可选悬浮进度（默认关）。
             不做 START_REDELIVER_INTENT：进程被杀后 Producer 协程已死，系统拿旧
             Intent 重启的只是一个空壳服务，onStartCommand 会立刻 stopSelf，
             等于多一次无效启动和日志噪声。恢复靠「每段落盘 + 开软件弹窗续跑」，
             这条链路在 R159 已验证。 -->
        <service
            android:name=".ProduceService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />
        <receiver android:name=".core.PlaybackActions" android:exported="false">
            <intent-filter>
                <action android:name="com.tingben.app.PLAY_TOGGLE" />
                <action android:name="com.tingben.app.PLAY_NEXT" />
                <action android:name="com.tingben.app.PLAY_PREV" />
                <action android:name="com.tingben.app.PLAY_STOP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

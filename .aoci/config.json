{
  "version": 2,
  "locale": "zh-CN",
  "index_path": "aoci.txt",
  "exclude_dirs": [
    ".git",
    "build",
    "dist",
    "node_modules",
    "__pycache__",
    ".venv",
    "dev",
    "reference",
    "samples",
    "contracts",
    "真机截图",
    "app/src/main/res",
    "gradle",
    "logs",
    "build-report"
  ],
  "exclude_files": [
    "*.apk",
    "*.gguf",
    "*.jks",
    "*.pyc",
    "*.backup.*",
    "*.bak"
  ],
  "exclude_exts": [],
  "curation_exclude": [
    "dev/**",
    "reference/**",
    "samples/**",
    "contracts/**",
    "真机截图/**",
    "R*_落地报告.md",
    "本地改码批次*.md"
  ],
  "hook_strict": false,
  "ledger_enabled": true,
  "line_ending_tolerance": true,
  "cognition_refresh_threshold": 30,
  "overview_delivery": {
    "chunk_tokens": 7000
  },
  "managed_scope": {
    "version": "managed-scope-policy/v2",
    "profile": "custom",
    "observe_change_policy": "review_required",
    "approval_mode": "inherit",
    "approval_thresholds": {
      "entry_removal_count": 25,
      "entry_removal_percent": 25
    },
    "rules": [
